rules_version = '2';

// ============================================================
//  隱哈歌利 En-hakkore — Firestore 安全規則
// ============================================================
//  這份規則是奉獻資料（donations 集合）真正的守門人。
//  前端任何 JS 陣列、localStorage、隱藏欄位都只是「使用者體驗」，
//  不具安全性；真正決定誰能讀、能寫的是這份 Rules。
//
//  ── 日後新增管理者 ──
//  只需在下方 isAdmin() 的 email 陣列裡「加入一行 email」，
//  再重新部署規則（firebase deploy --only firestore:rules 或
//  直接貼到 Firebase Console → Firestore → 規則）即可，
//  不必更動其他任何邏輯。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------
    // 管理者白名單
    // 以陣列形式比對登入者的 email（來自 Google 登入的 token），
    // 方便日後增減管理者：只要在陣列中增刪 email 即可。
    // 必須先通過 Firebase Authentication 登入（request.auth != null），
    // 才會有 token.email 可比對。
    // --------------------------------------------------------
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'einhakkore@gmail.com',
               's949391@gmail.com'
             ];
    }

    // --------------------------------------------------------
    // 建立奉獻資料時的欄位驗證
    // 目的：擋掉惡意灌入的巨大字串／不合法型別，避免有人塞垃圾
    //       資料灌爆 Firestore 配額。
    //   - hasOnly([...])：只允許白名單內的欄位，多一個都拒收。
    //   - createdAt / source 為系統寫入欄位（前端帶入），一併允許。
    //   - phone / address 在表單上為選填，因此以「若存在才檢查」處理。
    // --------------------------------------------------------
    function isValidDonation() {
      let data = request.resource.data;
      return
        // 只允許以下欄位，不得夾帶其他任何欄位
        data.keys().hasOnly(
          ['name', 'date', 'amount', 'last5', 'phone', 'address', 'createdAt', 'source']
        ) &&
        // 必填欄位型別與長度上限
        data.name  is string && data.name.size()  < 50   &&
        data.date  is string && data.date.size()  < 20   &&
        data.amount is number && data.amount > 0 && data.amount < 10000000 &&
        data.last5 is string && data.last5.size() == 5   &&
        // 選填欄位：若有帶值則需符合型別與長度上限
        (!('phone'   in data) || (data.phone   is string && data.phone.size()   < 30))  &&
        (!('address' in data) || (data.address is string && data.address.size() < 200)) &&
        // 系統欄位：型別把關（皆為選填，但若帶入需正確）
        (!('source'    in data) || data.source    is string) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // --------------------------------------------------------
    // 志工／技能媒合表單（volunteer.html → volunteers 集合）欄位驗證
    // --------------------------------------------------------
    function isValidVolunteer() {
      let data = request.resource.data;
      return
        data.keys().hasOnly(
          ['name', 'email', 'subject', 'category', 'message', 'createdAt', 'source']
        ) &&
        data.name    is string && data.name.size()    > 0 && data.name.size()    < 100  &&
        data.email   is string && data.email.size()   > 0 && data.email.size()   < 200  &&
        data.message is string && data.message.size() > 0 && data.message.size() < 5000 &&
        (!('subject'  in data) || (data.subject  is string && data.subject.size()  < 200)) &&
        (!('category' in data) || (data.category is string && data.category.size() < 100)) &&
        (!('source'    in data) || data.source    is string) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // --------------------------------------------------------
    // 聯絡表單（contact.html → contacts 集合）欄位驗證
    // --------------------------------------------------------
    function isValidContact() {
      let data = request.resource.data;
      return
        data.keys().hasOnly(
          ['name', 'email', 'category', 'message', 'createdAt', 'source']
        ) &&
        data.name    is string && data.name.size()    > 0 && data.name.size()    < 100  &&
        data.email   is string && data.email.size()   > 0 && data.email.size()   < 200  &&
        data.message is string && data.message.size() > 0 && data.message.size() < 5000 &&
        (!('category' in data) || (data.category is string && data.category.size() < 100)) &&
        (!('source'    in data) || data.source    is string) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // --------------------------------------------------------
    // donations 集合
    //   create ── 開放任何人（含未登入訪客）新增，但必須通過欄位驗證。
    //   read   ── 僅限白名單管理者，避免奉獻者個資外洩。
    //   update ── 一律禁止（奉獻紀錄不可被竄改）。
    //   delete ── 一律禁止（保留完整稽核紀錄）。
    // --------------------------------------------------------
    match /donations/{docId} {
      allow create: if isValidDonation();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // --------------------------------------------------------
    // volunteers / contacts 集合
    //   與 donations 相同的把關策略：
    //   任何人可 create（需通過欄位驗證），read 僅限管理者，
    //   update / delete 一律禁止。
    // --------------------------------------------------------
    match /volunteers/{docId} {
      allow create: if isValidVolunteer();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    match /contacts/{docId} {
      allow create: if isValidContact();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // --------------------------------------------------------
    // 其餘所有路徑：預設全部拒絕（deny by default）。
    // 日後若新增可公開的集合，再於此明確開放。
    // --------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
